[0.055, "o", "\u001b[?1049h\u001b[24;1H\u001b[?1h\u001b=\r\u001b[38;5;238m───────┬────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[m\r\n       \u001b[38;5;238m│ \u001b[0m\u001b[1mSTDIN\u001b[0m\u001b[m\r\n\u001b[38;5;238m───────┼────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[m\r\n\u001b[38;5;238m   1\u001b[0m   \u001b[38;5;238m│\u001b[0m \u001b[38;2;117;113;94m#\u001b[0m\u001b[38;2;117;113;94m fish_add_path '/home/rsteube/.config/carapace/bin'\u001b[0m\u001b[m\r\n\u001b[38;5;238m   2\u001b[0m   \u001b[38;5;238m│\u001b[0m \u001b[m\r\n\u001b[38;5;238m   3\u001b[0m   \u001b[38;5;238m│\u001b[0m \u001b[38;2;249;38;114mfunction\u001b[0m\u001b[38;2;255;255;255m \u001b[0m\u001b[38;2;166;226;46m_carapace_lazy\u001b[0m\u001b[m\r\n\u001b[38;5;238m   4\u001b[0m   \u001b[38;5;238m│\u001b[0m \u001b[38;2;255;255;255m   \u001b[0m\u001b[38;2;255;255;255mcomplete\u001b[0m\u001b[38;2;255;255;255m \u001b[0m\u001b[38;2;253;151;31m-\u001b[0m\u001b[38;2;253;151;31mc\u001b[0m\u001b[38;2;255;255;255m \u001b[0m\u001b[38;2;255;255;255m$\u001b[0m\u001b[38;2;255;255;255margv\u001b[0m\u001b[38;2;255;255;255m[\u001b[0m\u001b[38;2;190;132;255m1\u001b[0m\u001b[38;2;255;255;255m]\u001b[0m\u001b[38;2;255;255;255m \u001b[0m\u001b[38;2;253;151;31m-\u001b[0m\u001b[38;2;253;151;31me\u001b[0m\u001b[m\r\n\u001b[38;5;238m   5\u001b[0m   \u001b[38;5;238m│\u001b[0m \u001b[38;2;255;255;255m   \u001b[0m\u001b[38;2;255;255;255mcarapace\u001b[0m\u001b[38;2;255;255;255m \u001b[0m\u001b[38;2;255;255;255m$\u001b[0m\u001b[38;2;255;255;255margv\u001b[0m\u001b[38;2;255;255;255m[\u001b[0m\u001b[38;2;190;132;255m1\u001b[0m\u001b[38;2;255;255;255m]\u001b[0m\u001b[38;2;255;255;255m \u001b[0m\u001b[38;2;255;255;255mfish\u001b[0m\u001b[38;2;255;255;255m \u001b[0m\u001b[38;2;249;38;114m|\u001b[0m\u001b[38;2;255;255;255m \u001b[0m\u001b[38;2;255;255;255msource\u001b[0m\u001b[m\r\n\u001b[38;5;2