[1.012, "o", "\u0007\r\r\n\u001b[J\u001b[2mset-env <name> <value>\u001b[m\r\n\u001b[2;37mCompleting environment variables\u001b[m\r\n\u001b[0m\u001b[34mCARAPACE_BRIDGES\u001b[0m\u001b[2m        -- zsh,fish,bash\u001b[0m\r\n\u001b[34mCARAPACE_COMPLINE\u001b[0m\u001b[2m       -- set-env C\u001b[0m\r\n\u001b[34mCARAPACE_MATCH\u001b[0m\u001b[2m          -- 1\u001b[0m\r\n\u001b[34mCOLORTERM\u001b[0m\u001b[2m               -- truecolor\u001b[0m\r\n\u001b[34mCARAPACE_ZSH_HASH_DIRS\u001b[0m\r\n\u001b[2;37mCompleting known environment variables\u001b[m\r\n\u001b[0m\u001b[mCC\u001b[0m\u001b[2m         -- The command to use to compile C code\u001b[0m\r\n\u001b[mCXX\u001b[0m\u001b[2m        -- The command to use to compile C++ code\u001b[0m\r\n\u001b[J\u001b[mCARAPACE_\u001b[0m  \u001b[J\u001b[mCARGO_\u001b[0m     \u001b[J\u001b[mCGO_\u001b[0m     \u001b[J\u001b[11A\u001b[0m\u001b[27m\u001b[24m\r\u001b[6Cset-env C\u001b[K"]
[0.830, "o", "\u0007\r\r\n\u001b[J\u001b[2mset-env <name> <value>\u001b[m\r\n\u001b[2;37mCompleting environment variables\u001b[m\r\n\u001b[0m\u001b[34mCARAPACE_BRIDGES\u001b[0m\u001b[2m        -- zsh,fish,bash\u001b[0m\r\n\u001b[34mCARAPACE_COMPLINE\u001b[0m\u001b[2m       -- set-env C\u001b[0m\r\n\u001b[34mCARAPACE_MATCH\u001b[0m\u001b[2m          -- 1\u001b[0m\r\n\u001b[34mCOLORTERM\u001b[0m\u001b[2m               -- truecolor\u001b[0m\r\n\u001b[34mCARAPACE_ZSH_HASH_DIRS\u001b[0m\r\n\u001b[2;37mCompleting known environment variables\u001b[m\r\n\u001b[0m\u001b[mCC\u001b[0m\u001b[2m         -- The command to use to compile C code\u001b[0m\r\n\u001b[mCXX\u001b[0m\u001b[2m        -- The command to use to compile C++ code\u001b[0m\r\n\u001b[J\u001b[mCARAPACE_\u001b[0m  \u001b[J\u001b[mCARGO_\u001b[0m     \u001b[J\u001b[mCGO_\u001b[0m     \u001b[J\u001b[11A\u001b[0m\u001b[27m\u001b[24m\r\u001b[6Cset-env C\u001b[K"]
