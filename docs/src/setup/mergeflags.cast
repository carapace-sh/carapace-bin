[0.255, "o", "\u0007\r\r\n\u001b[J\u001b[2mset-env <name> <value>\u001b[m\r\n\u001b[2;37mCompleting environment variables\u001b[m\r\n\u001b[0m\u001b[34mCARAPACE_BRIDGES\u001b[0m\u001b[2m        -- zsh,fish,bash\u001b[0m\r\n\u001b[34mCARAPACE_COMPLINE\u001b[0m\u001b[2m       -- set-env CARAPACE_\u001b[0m\r\n\u001b[34mCARAPACE_MATCH\u001b[0m\u001b[2m          -- 1\u001b[0m\r\n\u001b[34mCARAPACE_ZSH_HASH_DIRS\u001b[0m\r\n\u001b[2;37mCompleting known environment variables\u001b[m\r\n\u001b[0m\u001b[mCARAPACE_COVERDIR\u001b[0m\u001b[2m    -- coverage directory for sandbox tests\u001b[0m\r\n\u001b[mCARAPACE_ENV\u001b[0m\u001b[2m         -- register get-env, set-env and unset-env\u001b[0m\r\n\u001b[mCARAPACE_EXCLUDES\u001b[0m\u001b[2m    -- internal completers to exclude\u001b[0m\r\n\u001b[mCARAPACE_HIDDEN\u001b[0m\u001b[2m      -- show hidden commands/flags\u001b[0m\r\n\u001b[mCARAPACE_LENIENT\u001b[0m\u001b[2m     -- allow unknown flags\u001b[0m\r\n\u001b[mCARAPACE_LOG\u001b[0m\u001b[2m         -- enable logging\u001b[0m\r\n\u001b[mCARAPACE_MERGEFLAGS\u001b[0m\u001b[2m  -- merge flags to single tag group\u001b[0m\r\n\u001b[mCARAPACE_NOSPACE\u001b[0m\u001b[2m     -- nospace suffixes\u001b[0m\r\n\u001b[mCARAPACE_SANDBOX\u001b[0m\u001b[2m     -- mock context for sandbox tests\u001b[0m\r\n\u001b[mCARAPACE_TOOLTIP\u001b[0m\u001b[2m     -- enable tooltip style\u001b[0m\r\n\u001b[J\u001b[mCARAPACE_UNFILTERED\u001b[0m\u001b[2m  -- skip the final filtering step\u001b[0m\u001b[J\u001b[18A\u001b[0m\u001b[27m\u001b[24m\r\u001b[6Cset-env CARAPACE_\u001b[K"]
