[0.000, "o", "\u001b[2;37mCompleting longhand flags\u001b[m\r\n"]
[0.000, "o", "\u001b[0m\u001b[m--bare\u001b[0m\u001b[2m                -- use $PWD as repository\u001b[0m\r\n\u001b[34m--exec-path\u001b[0m\u001b[2m           -- path containing core git-programs\u001b[0m\r\n\u001b[34m--git-dir\u001b[0m\u001b[2m             -- path to repository\u001b[0m\r\n\u001b[m--help\u001b[0m\u001b[2m                -- display help message\u001b[0m\r\n\u001b[m--html-path\u001b[0m\u001b[2m           -- display path to HTML documentation and exit\u001b[0m\r\n\u001b[m--info-path\u001b[0m\u001b[2m           -- print the path where the info files are installed and exit\u001b[0m\r\n\u001b[33m--list-cmds\u001b[0m\u001b[2m           -- list commands\u001b[0m\r\n\u001b[m--literal-pathspecs\u001b[0m\u001b[2m   -- treat pathspecs literally, rather than as glob patterns\u001b[0m\r\n\u001b[m--man-path\u001b[0m\u001b[2m            -- print the manpath for the man pages for this version of Git and exit\u001b[0m\r\n\u001b[34m--namespace\u001b[0m\u001b[2m           -- set the Git namespace\u001b[0m\r\n\u001b[m--no-pager\u001b[0m\u001b[2m            -- don't pipe git output into a pager\u001b[0m\r\n\u001b[m--no-replace-objects\u001b[0m\u001b[2m  -- do not use replacement refs to replace git objects\u001b[0m\r\n\u001b[m--paginate\u001b[0m\u001b[2m            -- pipe output into a pager\u001b[0m\r\n\u001b[m--version\u001b[0m\u001b[2m             -- display version information\u001b[0m\r\n\u001b[34m--work-tree\u001b[0m\u001b[2m           -- path to working tree\u001b[0m\r\n\u001b[2;37mCompleting shorthand flags\u001b[m\r\n\u001b[0m\u001b[34m-c\u001b[0m\u001b[2m  -- pass configuration parameter to command\u001b[0m\r\n\u001b[34m-C\u001b[0m\u001b[2m  -- run as if git was started in given path\u001b[0m\r\n\u001b[m-P\u001b[0m\u001b[2m  -- don't pipe git output into a pager\u001b[0m\r\n\u001b[J\u001b[m-p\u001b[0m\u001b[2m  -- pipe output into a pager\u001b[0m\u001b[J\u001b[21A\u001b[0m\u001b[27m\u001b[24m\r\u001b[6Cgit -\u001b[K"]
